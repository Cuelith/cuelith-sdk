{
  "name": "@cuelith/panel",
  "version": "0.8.0",
  "description": "Helpers for Cuelith plugin panels: call the plugin commands and follow the show state from an isolated panel.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cuelith/cuelith-sdk.git",
    "directory": "packages/panel"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@cuelith/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/Cuelith/cuelith-sdk#readme",
  "bugs": "https://github.com/Cuelith/cuelith-sdk/issues"
}
