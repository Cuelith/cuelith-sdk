{
  "name": "@cuelith/protocol",
  "version": "0.1.0",
  "description": "Tipi, schemi e metodi del protocollo di Cuelith: l'unico contratto tra motore, postazioni e moduli.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cuelith/cuelith-sdk.git",
    "directory": "packages/protocol"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "schema": "node scripts/generate-schema.js"
  },
  "dependencies": {
    "fast-json-patch": "3.1.1",
    "semver": "7.8.5",
    "ulid": "3.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/semver": "7.8.0",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
